# Copia este archivo a .env (mismo directorio) y rellena lo tuyo.
# El script lo carga solo; las variables de entorno reales tienen prioridad.

# --- Traderie ---------------------------------------------------------------
# Header 'authorization' de tu sesión (DevTools > Network > cualquier XHR a
# traderie.com/api > Request Headers). Caduca: hay que renovarlo cada tanto.
# Ya no hace falta el user id: /notifications viene filtrado por el token.
TRADERIE_AUTH=
TRADERIE_GAME=diablo2resurrected

# Traderie está tras Cloudflare y bloquea a python-requests por huella TLS.
# curl_cffi imita a Chrome. Si algún día vuelve el 403 "Just a moment",
# prueba: chrome131, chrome120, safari17_0
TRADERIE_IMPERSONATE=chrome

# --- Qué vigilar ------------------------------------------------------------
# Coma-lista. Mapean a los 'type' de la campanita de Traderie:
#   accepted  -> offer-accepted      te aceptaron TU oferta   <- lo que querías
#   incoming  -> offer-new           alguien ofertó por un listing tuyo
#   completed -> offer-complete      trade completado
#   denied    -> offer-denied        te rechazaron la oferta
#   cancelled -> offer-buyer-cancel  el comprador canceló
#   reopened  -> offer-reopen        oferta reabierta
#   review    -> review              te dejaron reseña
#   message   -> message             mensaje nuevo
WATCH_EVENTS=accepted

POLL_SECONDS=60
STATE_FILE=seen_offers.json

# --- Canales ----------------------------------------------------------------
# telegram, whatsapp, email (coma-separados)
NOTIFY_CHANNELS=telegram

# -- Telegram --
# Token de @BotFather. Dale /start a TU bot, luego corre:
#   python traderie-notifications.py --chatid
# y te rellena el chat id solo.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# -- WhatsApp --
# callmebot = gratis, 2 min de setup. Escribe "I allow callmebot to send me
#             messages" al +34 621 33 15 75 y te devuelve el apikey.
# cloud     = WhatsApp Cloud API de Meta (oficial). Ojo: solo permite texto
#             libre dentro de las 24 h siguientes a que TÚ le escribas al
#             número; fuera de esa ventana necesitas una plantilla aprobada.
WHATSAPP_PROVIDER=callmebot
WHATSAPP_TO=+56900000000
WHATSAPP_CALLMEBOT_APIKEY=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_ID=

# -- Email --
# En Gmail/Outlook usa un App Password, NO tu contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
